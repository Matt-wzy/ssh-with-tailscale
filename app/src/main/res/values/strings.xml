    <!-- Port forwarding -->
    <string name="fwd_title">端口转发</string>
    <string name="fwd_dir_local">本地 -L：手机监听，由 SSH 服务端去连目标</string>
    <string name="fwd_dir_remote">远程 -R：服务端监听，由手机去连目标（经 Tailscale）</string>
    <string name="fwd_bind_host">绑定地址</string>
