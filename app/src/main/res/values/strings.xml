    <!-- About -->
    <string name="action_about">关于</string>
    <string name="about_title">关于</string>
    <string name="about_version">版本 %1$s（%2$d）</string>
    <string name="about_intro">把 Tailscale 节点直接嵌进 App，无需 VpnService、无需 root。\n可以在 tailnet 上 SSH 到任意设备，也能反过来把手机做成 tailnet 上的服务端。</string>
    <string name="about_features_heading">功能</string>
    <string name="about_features">
        · SSH over tailnet —— 经 SOCKS5 走 WireGuard 隧道连到 100.x.x.x。\n
        · 端口转发 —— 本地 -L / 远程 -R。\n
        · 反向导出 —— 手机在 tailnet 上监听，做中继或 HTTP 代理，手机即服务端。\n
        · 文件管理 —— SFTP 浏览/上传/下载，多文件并行，碎文件服务器端打包。\n
        · Tailnet 设备列表 —— 查看在线节点。
    </string>
    <string name="about_tech_heading">技术实现</string>
    <string name="about_tech">
        Tailscale 以 userspace（netstack）模式运行：不创建 TUN 设备，不占用系统唯一的 VpnService 槽位，因此可以和企业 VPN 等其它 VPN 应用共存。\n\n
        Go 侧用 gomobile 打成 AAR，编译进 App。
    </string>
    <string name="about_opensource_heading">开源组件</string>
    <string name="about_opensource">
        · tailscale.com（BSD-3-Clause）\n
        · things-go/go-socks5\n
        · com.github.mwiede:jsch（SSH，com.jcraft:jsch 的维护分支）\n
        · Material Components for Android
    </string>

