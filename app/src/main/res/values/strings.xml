    <!-- Reverse export (publish on the tailnet) -->
    <string name="pub_title">反向导出</string>
    <string name="pub_dir_relay">中继：在 tailnet 上监听，连接被转给手机局域网里的设备</string>
    <string name="pub_dir_proxy">代理：在 tailnet 上起一个 HTTP 代理，tailnet 设备可经手机上网</string>
    <string name="pub_listen_port">tailnet 监听端口</string>
    <string name="pub_target_host">目标主机（手机局域网 IP）</string>
    <string name="pub_target_port">目标端口</string>
    <string name="pub_help_relay">手机在 tailnet 上监听该端口，所有连进来的连接会被中继到「目标主机:端口」。\n目标主机从手机自身网络发出，所以能填手机 Wi-Fi 网段里的设备（如 192.168.1.50:80）。</string>
    <string name="pub_help_proxy">手机在 tailnet 上监听该端口，作为 HTTP 代理。\n其他 tailnet 设备把代理设成 100.x.x.x:端口 后，流量经手机出去。无需 SSH、无需 VpnService、无需管理员批准。</string>
    <string name="pub_add">添加</string>
    <string name="pub_empty">还没有导出规则。添加后 Tailscale 连上会自动生效，且常驻。</string>
