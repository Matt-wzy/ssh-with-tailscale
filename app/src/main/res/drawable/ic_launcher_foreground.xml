<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a shell prompt, the ">" of a command line and the
  "_" of the cursor waiting for input.

  Geometry is centred on (54,54) and kept inside the 66dp safe zone (a circle of
  radius 33 centred there). The furthest stroke point sits ~30dp from centre, so
  even a circular launcher mask keeps both marks whole. Stroke width is generous
  on purpose: at 48dp these two marks still read as a terminal.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Prompt ">". -->
    <path
        android:fillColor="#00000000"
        android:pathData="M32,40 L48,54 L32,68"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cursor "_". -->
    <path
        android:fillColor="#00000000"
        android:pathData="M56,68 L76,68"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
