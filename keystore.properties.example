# Release signing config. Copy to `keystore.properties` at the repo root and fill in.
#
#     cp keystore.properties.example keystore.properties
#
# `keystore.properties` and the .jks it points at are both gitignored -- never
# commit either. Without them `./gradlew assembleRelease` still succeeds but the
# APK comes out unsigned (it cannot be installed until you sign it yourself).
#
# Generate a keystore with:
#
#     keytool -genkeypair -v \
#       -keystore release.jks \
#       -alias <ALIAS> \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks up somewhere safe and keep it out of git. Losing it means you can
# never ship an update that upgrades an already-installed copy of the app in
# place -- Android rejects an APK signed with a different key.

# Path is resolved relative to the repo root.
storeFile=release.jks

# Passwords for the keystore and for the key inside it. Generate real ones, e.g.
#     keytool -genkeypair ... -storepass "$(openssl rand -base64 24)"
storePassword=

# Key alias as created by keytool -alias.
keyAlias=

# Often identical to storePassword, but keytool lets you set them separately.
keyPassword=
